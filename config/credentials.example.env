# StellarBlue Internal Tool (Orbit) - Credentials Template
# When you are ready to connect to production/preview services, paste your credentials into .env.local

# ==============================================================================
# 1. SUPABASE DATABASE & STORAGE CREDENTIALS
# ==============================================================================
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Service role key MUST remain server-side only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"

# Postgres Direct Connection String (for running migrations or deep diagnostics)
DATABASE_URL="postgres://postgres:your-db-password@your-project-ref.supabase.co:5432/postgres"

# ==============================================================================
# 2. MICROSOFT ENTRA ID (AZURE AD OIDC) SSO CONFIGURATION
# ==============================================================================
# In Supabase -> Authentication -> Providers -> Azure OIDC
# Enter your Azure tenant ID to validate token claims (prevents multi-tenant spoofing)
ENTRA_ID_TENANT_ID="your-azure-tenant-id-guid"
ENTRA_ID_CLIENT_ID="your-application-client-id"
ENTRA_ID_CLIENT_SECRET="your-azure-client-secret-value"

# ==============================================================================
# 3. SERVER-GUARDED DEV AUTH MODE & LOCAL MOCKING
# ==============================================================================
# CRITICAL SAFETY GUARANTEE: DEV_AUTH_MODE is a server-side only environment variable.
# Even if set to true, application initialization HARD-FAILS in production environments
# (NODE_ENV=production or VERCEL_ENV=production) to prevent auth bypass leaks.
DEV_AUTH_MODE="true"

# When DEV_AUTH_MODE=true, the system will use seeded test users for RLS testing
# Default mock user email to boot up with (e.g. founder/admin vs employee)
DEV_MOCK_USER_EMAIL="eleni.founta@stellarblue.gr"

# Temporary credential sign-in for preview deployments (Vercel Preview environment only).
# Entra ID rejects the *.vercel.app callback until the app registration allows it, so the preview
# shows a username/password form backed by Supabase email auth instead. Leave unset everywhere else:
# the form never renders unless this is exactly "true" at build time.
NEXT_PUBLIC_PREVIEW_LOGIN="true"
# Bare usernames typed into that form are expanded to this domain (default: stellarblue.eu).
NEXT_PUBLIC_PREVIEW_LOGIN_DOMAIN="stellarblue.eu"

# ==============================================================================
# 4. CRON & NOTIFICATION SERVICES
# ==============================================================================
# Resend API Key for React Email templates and system notifications
RESEND_API_KEY="re_your_resend_api_key_here"
DEFAULT_FROM_EMAIL="orbit@stellarblue.gr"

# Vercel Cron authentication secret (required bearer token for cron route handlers)
CRON_SECRET="your-secure-cron-bearer-token"

# ==============================================================================
# 5. SLACK STATUS MIRRORING (Orbit -> Slack, mandatory onboarding)
# ==============================================================================
# Create a Slack app: https://api.slack.com/apps -> OAuth & Permissions
# Redirect URL:  <NEXT_PUBLIC_APP_URL>/api/slack/callback
# Bot Token Scopes: (none required — uses user tokens via users.profile:write)
# User Token Scopes: users.profile:read, users.profile:write
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"

# Public base URL used to build the Slack OAuth redirect URI
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"

# ==============================================================================
# 6. MICROSOFT GRAPH (Outlook Calendar Mirroring)
# ==============================================================================
# Azure App Registration "Orbit Outlook Sync".
# Orbit signs each employee in individually (authorization code flow) because the Outlook work plan
# rejects application-only tokens — so the API permission must be the DELEGATED
# "Microsoft Graph -> Delegated permissions -> Calendars.ReadWrite", consented for the tenant.
# (An Application permission with client credentials is NOT used by this flow.)
#
# Authentication -> Redirect URIs (platform: Web): one per address people use Orbit on.
#   https://app.orbit.stellarblue.eu/api/msal/callback
#   http://localhost:3000/api/msal/callback
# The callback is built from the origin the browser is actually on, not from NEXT_PUBLIC_APP_URL.
# A missing redirect URI fails with AADSTS50011; missing tenant consent with AADSTS65001 —
# the profile page now shows that code when a connection attempt fails.
#
# The same registration also serves the server-side integrations: the APPLICATION permission
# "Microsoft Graph -> Application permissions -> Calendars.ReadWrite" (admin consent) reads and
# books room mailboxes, and "Place.ReadWrite.All" (application, admin consent) lets Spaces ->
# Manage -> "Sync to Outlook" create the rooms in Outlook. Place management also needs the Exchange
# application roles MailRecipient and TenantPlacesManagement for this app, and the tenant Places
# setting (see docs/outlook-room-sync-setup.md).
GRAPH_CLIENT_ID="your-azure-application-client-id"
GRAPH_CLIENT_SECRET="your-azure-client-secret-value"
GRAPH_TENANT_ID="your-azure-tenant-id"
