# StellarBlue Internal Tool (Orbit) - Credentials Template
# When you are ready to connect to production/preview services, paste your credentials into .env.local

# ==============================================================================
# 1. SUPABASE DATABASE & STORAGE CREDENTIALS
# ==============================================================================
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Service role key MUST remain server-side only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"

# Postgres Direct Connection String (for running migrations or deep diagnostics)
DATABASE_URL="postgres://postgres:your-db-password@your-project-ref.supabase.co:5432/postgres"

# ==============================================================================
# 2. MICROSOFT ENTRA ID (AZURE AD OIDC) SSO CONFIGURATION
# ==============================================================================
# In Supabase -> Authentication -> Providers -> Azure OIDC
# Enter your Azure tenant ID to validate token claims (prevents multi-tenant spoofing)
ENTRA_ID_TENANT_ID="your-azure-tenant-id-guid"
ENTRA_ID_CLIENT_ID="your-application-client-id"
ENTRA_ID_CLIENT_SECRET="your-azure-client-secret-value"

# ==============================================================================
# 3. SERVER-GUARDED DEV AUTH MODE & LOCAL MOCKING
# ==============================================================================
# CRITICAL SAFETY GUARANTEE: DEV_AUTH_MODE is a server-side only environment variable.
# Even if set to true, application initialization HARD-FAILS in production environments
# (NODE_ENV=production or VERCEL_ENV=production) to prevent auth bypass leaks.
DEV_AUTH_MODE="true"

# When DEV_AUTH_MODE=true, the system will use seeded test users for RLS testing
# Default mock user email to boot up with (e.g. founder/admin vs employee)
DEV_MOCK_USER_EMAIL="eleni.founta@stellarblue.gr"

# ==============================================================================
# 4. CRON & NOTIFICATION SERVICES
# ==============================================================================
# Resend API Key for React Email templates and system notifications
RESEND_API_KEY="re_your_resend_api_key_here"
DEFAULT_FROM_EMAIL="orbit@stellarblue.gr"

# Vercel Cron authentication secret (required bearer token for cron route handlers)
CRON_SECRET="your-secure-cron-bearer-token"

# ==============================================================================
# 5. SLACK STATUS MIRRORING (Orbit -> Slack, mandatory onboarding)
# ==============================================================================
# Create a Slack app: https://api.slack.com/apps -> OAuth & Permissions
# Redirect URL:  <NEXT_PUBLIC_APP_URL>/api/slack/callback
# Bot Token Scopes: (none required — uses user tokens via users.profile:write)
# User Token Scopes: users.profile:read, users.profile:write
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"

# Public base URL used to build the Slack OAuth redirect URI
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"
